DATABASE_URL=postgresql+asyncpg://claimsense:securepassword@postgres:5432/claimsensedb
REDIS_URL=redis://redis:6379/0
GROQ_API_KEY=your_groq_api_key_here

# Signs session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it the app mints an ephemeral key and every restart signs users out.
JWT_SECRET=replace_me_with_a_generated_secret

# Shared password for the seeded demo accounts.
DEMO_PASSWORD=claimsense-demo

# Set true only when served over HTTPS; a Secure cookie is dropped over plain http.
COOKIE_SECURE=false
